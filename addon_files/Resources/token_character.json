{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/token.json",
  "name": "token",
  "prefix": "token",
  "size": 1,
  "object": {
    "type": "image",
    "version": "5.3.0",
    "originX": "left",
    "originY": "top",
    "fill": "rgb(0,0,0)",
    "stroke": null,
    "strokeWidth": 0,
    "strokeDashArray": null,
    "strokeLineCap": "butt",
    "strokeDashOffset": 0,
    "strokeLineJoin": "miter",
    "strokeUniform": false,
    "strokeMiterLimit": 4,
    "angle": 0,
    "opacity": 1,
    "visible": true,
    "fillRule": "nonzero",
    "paintFirst": "fill",
    "globalCompositeOperation": "source-over",
    "crossOrigin": null,
    "filters": []
  },
  "editableProps": [
    {
      "name": "hp",
      "dtoProperty": "hp",
      "label": "HP",
      "source": "card"
    }
  ],
  "assignableIcons": [
