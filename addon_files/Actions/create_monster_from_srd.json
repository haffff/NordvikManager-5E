{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "create_monster_from_srd",
  "hook": 0,
  "prefix": "dnd5e",
  "isEnabled": false,
  "content": [
    {
      "id": "37151ff4-cd9f-4695-9fec-eb9f6a81dce2",
      "Data": {
        "Label": "Create monster card from template",
        "Name": "%name%",
        "TemplateId": "%q:card[5E Monster Template].id%",
        "Owner": "%playerId%",
        "Output": "newCardId"
      },
      "Type": "CreateCard"
    },
    {
      "id": "c091abce-feaa-4e23-b43c-77b6f5cf8643",
      "Data": {
        "Label": "Fill in the stat block (props sent by the monster creator)",
        "Collection": "props",
        "ItemName": "prop",
        "Do": [
          {
            "id": "392d2d4c-8d14-59b9-b524-9fafd7871678",
            "Data": {
              "Label": "Set one property of the new card",
              "ParentId": "%newCardId%",
              "PropertyName": "%prop.name%",
              "PropertyValue": "%prop.value%"
            },
            "Type": "SetProperty"
          }
        ]
      },
      "Type": "ForEach"
    },
    {
      "id": "b2701379-3d05-4a33-bcea-162d780bc1b2",
      "Data": {
        "Label": "Place its token when opened from the map",
        "Condition": "'%hasMapContext%' = 'true'",
        "Then": [
          {
            "id": "17fdf680-b810-5528-8637-39b82e5b9ef5",
            "Data": {
              "Label": "Spawn token for the new monster card",
              "Panel": "BattleMap_token",
              "Command": "CreateToken",
              "Player": "%playerId%",
              "Data": "{\"contextId\": \"%battleMapId%\", \"cardId\": \"%newCardId%\", \"position\": %position%}"
            },
            "Type": "RunClientCommand"
          }
        ]
      },
      "Type": "If"
    }
  ],
  "gmPermission": 31
}
