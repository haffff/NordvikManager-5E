{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "create_item_from_srd",
  "hook": 0,
  "prefix": "dnd5e",
  "isEnabled": false,
  "content": [
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000001",
      "Data": {
        "Label": "Create item card from template",
        "Name": "%name%",
        "TemplateId": "%q:card[5E Item Template].id%",
        "Owner": "%playerId%",
        "Output": "newCardId"
      },
      "Type": "CreateCard"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000002",
      "Data": {
        "Label": "Set item name",
        "ParentId": "%newCardId%",
        "PropertyName": "item_name",
        "PropertyValue": "%name%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000003",
      "Data": {
        "Label": "Set item type",
        "ParentId": "%newCardId%",
        "PropertyName": "item_type",
        "PropertyValue": "%itemType%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000004",
      "Data": {
        "Label": "Set item rarity",
        "ParentId": "%newCardId%",
        "PropertyName": "item_rarity",
        "PropertyValue": "%rarity%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000005",
      "Data": {
        "Label": "Set item weight",
        "ParentId": "%newCardId%",
        "PropertyName": "item_weight",
        "PropertyValue": "%weight%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000006",
      "Data": {
        "Label": "Set item value",
        "ParentId": "%newCardId%",
        "PropertyName": "item_value",
        "PropertyValue": "%value%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000007",
      "Data": {
        "Label": "Set item description",
        "ParentId": "%newCardId%",
        "PropertyName": "item_description",
        "PropertyValue": "%description%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000009",
      "Data": {
        "Label": "Set item image reference",
        "ParentId": "%newCardId%",
        "PropertyName": "item_image_ref",
        "PropertyValue": "%imageRef%"
      },
      "Type": "SetProperty"
    },
    {
      "id": "a8a8a8a8-0d00-4a00-8a00-000000000008",
      "Data": {
        "Label": "Spawn token if created from the battle map's Add menu",
        "Condition": "'%hasMapContext%' = 'true'",
        "Then": [
          {
            "id": "89ca3a5e-31ea-5796-b719-f7d4cf263801",
            "Data": {
              "Label": "Spawn token for newly created item card",
              "Panel": "BattleMap_token",
              "Command": "CreateToken",
              "Player": "%playerId%",
              "Data": "{\"contextId\": \"%battleMapId%\", \"cardId\": \"%newCardId%\", \"position\": %position%}"
            },
            "Type": "RunClientCommand"
          }
        ]
      },
      "Type": "If"
    }
  ]
}
