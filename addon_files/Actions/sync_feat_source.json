{
  "$schema": "https://raw.githubusercontent.com/haffff/NordvikManager-Addons/refs/heads/main/schemas/action.json",
  "name": "sync_feat_source",
  "hook": 0,
  "prefix": "dnd5e",
  "isEnabled": false,
  "content": [
    {
      "id": "bd2310c5-1ae0-4370-a27c-6f6223e1fd39",
      "Data": {
        "Label": "Fetch feat source",
        "TargetUrl": "%feat_url%",
        "HttpMethod": "GET",
        "ParentId": "",
        "Output": "output"
      },
      "Type": "SendRequest"
    },
    {
      "id": "2833ec6d-b21c-49dc-a0b6-dd94219a28e5",
      "Data": {
        "Label": "Branch on success",
        "Condition": "%output.StatusCode% = 200",
        "Then": [
          {
            "id": "278c1d87-3731-576a-8dbe-13a0a13f8082",
            "Data": {
              "Label": "Save feat source to resources",
              "Key": "%feat_key%",
              "Name": "%feat_key%",
              "Content": "%output.ResponseBody%",
              "MimeType": "application/json"
            },
            "Type": "SetResource"
          },
          {
            "id": "6e19a37b-fda5-5a58-b3c4-a090187396a1",
            "Data": {
              "Label": "Mark sync status ok",
              "ParentId": "%gameId%",
              "PropertyName": "dnd5e_sync_status_%feat_key%",
              "PropertyValue": "ok"
            },
            "Type": "SetProperty"
          }
        ],
        "Else": [
          {
            "id": "b9bbfcbd-0b97-56d7-a3db-11aaa6cd6238",
            "Data": {
              "Label": "Mark sync status failed",
              "ParentId": "%gameId%",
              "PropertyName": "dnd5e_sync_status_%feat_key%",
              "PropertyValue": "error:%output.StatusCode%"
            },
            "Type": "SetProperty"
          }
        ]
      },
      "Type": "If"
    }
  ],
  "gmPermission": 31
}
